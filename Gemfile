# Gems for building and previewing the site locally.
# GitHub Pages ignores this file and builds with its own pinned versions;
# the github-pages gem mirrors those versions so local builds match.
source 'https://rubygems.org'

# Jekyll and every plugin at the versions GitHub Pages uses.
gem 'github-pages'

# Local web server used by `jekyll serve`; no longer bundled with Ruby 3.
gem 'webrick'

# Time zone data for the `timezone` setting; Windows has no system zoneinfo.
gem 'tzinfo-data', platforms: [:windows]

# Native file-change watcher for `jekyll serve` on Windows.
gem 'wdm', '>= 0.1.0', platforms: [:windows]
